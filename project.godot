; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="pkmn-project"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=240
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://dhc56fhaga4cw"

[autoload]

DebugLayer="*uid://6ieesaoekp61"
GameData="*uid://bh7tur0ewgvsd"
TypesManager="*uid://dwjlesyj614p5"
MovesManager="*uid://bwi5bj2lw36yb"
SpeciesManager="*uid://jgt41ukcq5s8"
Calculator="*uid://mjtbw7p8r8nr"
DialogueManager="*uid://c3rodes2l3gxb"

[dialogue_manager]

runtime/balloon_path="res://src/scenes/dialogue/balloon.tscn"

[display]

window/size/viewport_width=512
window/size/viewport_height=384
window/size/resizable=false
window/size/sharp_corners=true
window/size/maximize_disabled=true
window/subwindows/embed_subwindows=false
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=0

[editor]

naming/script_name_casing=2

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[global]

save_file_extension=".tres"

[global_group]

Cameras=""
BattleManager=""
Player=""
OverworldUIManager=""

